<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No CALL_PHONE (Aman opens the dialer), no SMS / contacts permissions: the message guard only
         reads notifications after the user enables Notification access for SAQR. -->
    <application
        android:name=".SaqrApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaqrShield"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Message guard. exported=true is required so the system can bind it; the BIND permission
             means only the system can. -->
        <service
            android:name=".guard.SaqrNotificationListenerService"
            android:exported="true"
            android:label="@string/guard_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Web blocker. Reads only the address bar of four browsers (see accessibility_service_config).
             exported=true so the system can bind it; BIND_ACCESSIBILITY_SERVICE means only the system can. -->
        <service
            android:name=".guard.SaqrBrowserGuardService"
            android:exported="true"
            android:label="@string/web_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Full-screen block, started only by the web blocker. Own task so finishing returns to
             the browser; never in recents. -->
        <activity
            android:name=".ui.BlockAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="ae.saqrintel.shield.block" />
    </application>
</manifest>
