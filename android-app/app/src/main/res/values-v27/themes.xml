<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 27+: dark navigation bar icons on the light sandstone window as well. -->
    <style name="Theme.SaqrShield" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/saqr_canvas</item>
        <item name="android:colorBackground">@color/saqr_canvas</item>
        <item name="android:colorAccent">@color/saqr_obsidian</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
