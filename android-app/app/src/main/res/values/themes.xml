<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme only for the window before Compose draws (no appcompat).
         Night Grid is dark by default, so the window starts on the dark canvas. -->
    <style name="Theme.SaqrShield" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
