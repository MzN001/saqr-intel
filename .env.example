# ---------------------------------------------------------------- SAQR-INTEL
APP_ENV=development
DATABASE_PATH=./data/saqr_intel.db
CORS_ORIGINS=https://saqr-intel.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- LLM
# auto = Claude if ANTHROPIC_API_KEY set, else Gemini if GEMINI_API_KEY set, else OpenAI if OPENAI_API_KEY set,
# else the offline rules engine. With Claude first, Gemini / OpenAI stay in the chain as fallbacks and Gemini
# gives the second opinion.
# If the primary provider fails/times out, the next one is tried, then the rules engine.
LLM_PROVIDER=auto
# Claude (paid key from https://console.anthropic.com). ANTHROPIC_MODEL is a comma list tried in order,
# e.g. claude-opus-5-5 (default) or claude-sonnet-5-5 (cheaper). ANTHROPIC_EFFORT: low | medium | high.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
# Second opinion: when the first answer is unsure (score 40-69 or confidence < 0.8) ONE more call is made
# on this model (comma list) within LLM_TIMEOUT_SECONDS; a failed second call keeps the first answer.
# Empty = the next healthy GEMINI_MODEL that did not answer first. gemini-4-argon is not on the free tier
# (the circuit breaker then rests it for 24 h and the GEMINI_MODEL chain is used instead).
GEMINI_SECOND_OPINION_MODEL=gemini-4-argon
# true|false - false switches the verification pass off (one LLM call per scan, as before).
LLM_SECOND_OPINION=true

# ---------------------------------------------------------------- Network intel
# true = no WHOIS/DNS/TLS/LLM/OSM calls at all (stage demo with no internet)
OFFLINE_MODE=false
WHOIS_TIMEOUT_SECONDS=8
DNS_TIMEOUT_SECONDS=3
TLS_TIMEOUT_SECONDS=5
# Comma-separated extra official domains to whitelist
EXTRA_WHITELIST_DOMAINS=

# ---------------------------------------------------------------- Sandbox
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_MS=15000
SANDBOX_MAX_CONCURRENCY=3
# Custom Chromium binary (leave empty to use Playwright's bundled browser)
PLAYWRIGHT_CHROMIUM_PATH=
# NEVER enable in production: lets the sandbox reach localhost/private IPs (SSRF)
ALLOW_PRIVATE_TARGETS=false
# Optional UAE residential/mobile egress proxy to defeat datacenter-IP cloaking
SANDBOX_PROXY_SERVER=
SANDBOX_PROXY_USERNAME=
SANDBOX_PROXY_PASSWORD=
# Screenshot similarity (corroborates the always-on brand fingerprint). Deep scans of suspicious,
# non-official links only; never official / private / /mock-scam/ addresses, never with OFFLINE_MODE.
# PRIVACY: without a Playwright screenshot this SENDS THE SUSPICIOUS URL to image.thum.io (and to
# s0.wp.com/mshots when Pillow is installed). Set false to keep every URL in-house.
# Measured cost: +0.2 MB RAM (pure-Python PNG decode, no Pillow needed).
VISUAL_SCREENSHOTS=true
# Hard cap 6 seconds; failure is silent
VISUAL_SCREENSHOT_TIMEOUT_SECONDS=6

# ---------------------------------------------------------------- Maps
# Google Places API (New). Without it, seeded intel + caller-supplied fields are used.
GOOGLE_MAPS_API_KEY=
OSM_REVERSE_GEOCODE=true

# ---------------------------------------------------------------- Certificate Transparency
# simulated | certstream | off
CT_MODE=simulated
CERTSTREAM_URL=wss://certstream.calidog.io/
CT_SIM_INTERVAL_SECONDS=12
CT_ALERT_THRESHOLD=45

# ---------------------------------------------------------------- Proactive hunter
# Finds scam domains BEFORE any citizen sees them: look-alike names checked in DNS, new certificates
# (crt.sh + the CT monitor above) and the daily newly-registered-domains list (whoisds.com, free).
# live | simulated (synthetic, labelled leads, no network) | off. OFFLINE_MODE=true makes live simulated.
HUNTER_MODE=live
HUNTER_SOURCES=lookalike_sweep,crtsh,ct,nrd
HUNTER_INTERVAL_SECONDS=900
# Limits per cycle (keep them low on a small server)
HUNTER_MAX_SCANS_PER_CYCLE=12
HUNTER_SCAN_CONCURRENCY=2
HUNTER_SWEEP_BATCH=600
HUNTER_LOOKALIKES_PER_BRAND=300
HUNTER_DNS_CONCURRENCY=25
# Lexical + URL-model score a lead needs to earn a full scan
HUNTER_TRIAGE_THRESHOLD=35
# true = hunter scans also ask the LLM (uses the same quota as citizen scans)
HUNTER_USE_LLM=false
HUNTER_CRTSH_QUERIES=3
HUNTER_CRTSH_MAX_AGE_HOURS=168
HUNTER_ESTABLISHED_DAYS=730

# ---------------------------------------------------------------- Phone DNS shield (NextDNS)
# Free account at https://nextdns.io. Profile ID = the "Configuration ID" on the Setup page,
# API key = Account page. SAQR then pushes every high-risk domain to that profile's Denylist,
# and phones using the profile (iPhone DNS profile / Android Private DNS) block them in every app.
NEXTDNS_PROFILE_ID=
NEXTDNS_API_KEY=
NEXTDNS_SYNC_INTERVAL_SECONDS=60
NEXTDNS_MIN_SCORE=65
NEXTDNS_INCLUDE_CT=false

# ---------------------------------------------------------------- Email scanning
# Live phishing-campaign feeds (CERT / vendor RSS) on top of the built-in list; OFFLINE_MODE also stops them.
CAMPAIGN_FEEDS=true
CAMPAIGN_REFRESH_HOURS=6
# Own limit for POST /api/analyze-email per address (empty = same as RATE_LIMIT_PER_MINUTE, 0 = off)
EMAIL_RATE_LIMIT_PER_MINUTE=
# Extra mail servers whose Authentication-Results header is trusted (Gmail/Outlook/Yahoo/iCloud/Zoho/Proton built in)
EMAIL_TRUSTED_AUTHSERV=
# Laptop only: allow a citizen's own AI address to be local (e.g. Ollama http://127.0.0.1:11434/v1). Never in the cloud.
USER_LLM_ALLOW_PRIVATE=false

# ---------------------------------------------------------------- Security
# When set, police endpoints require header `X-API-Key: <key>` and WS needs `?token=<key>`.
# Citizen endpoints (/api/analyze-url, /api/scan-maps) stay public but rate-limited.
POLICE_API_KEY=
RATE_LIMIT_PER_MINUTE=30
# "Report a false alarm" (POST /api/feedback/false-alarm): reports per minute per address (0 = off)
FEEDBACK_RATE_LIMIT_PER_MINUTE=3

# ---------------------------------------------------------------- Privacy
# Days to keep safe results and email checks (0 = keep forever). Links judged to be scams are kept
# as blocklist evidence (their pasted message text is removed); seeded demo scans are never deleted.
SCAN_RETENTION_DAYS=30
