{
  "manifest_version": 3,
  "name": "SAQR-INTEL | Citizen Web & Maps Scam Shield",
  "short_name": "SAQR Shield",
  "version": "1.2.0",
  "description": "Real-time Abu Dhabi Police scam protection for Chrome & Edge. Checks every website, Google Maps link and Gmail / Outlook email with SAQR-INTEL before you type anything.",
  "permissions": [
    "webNavigation",
    "tabs",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SAQR-INTEL Scam Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/email_features.js",
        "lib/user_model.js",
        "lib/campaign_match.js",
        "content/common.js",
        "content/gmail.js"
      ],
      "css": [
        "content/mail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "lib/email_features.js",
        "lib/user_model.js",
        "lib/campaign_match.js",
        "content/common.js",
        "content/outlook.js"
      ],
      "css": [
        "content/mail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://www.icloud.com/mail*",
        "https://mail.aol.com/*",
        "https://mail.zoho.com/*"
      ],
      "js": [
        "lib/config.js",
        "content/wip.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "shield.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
