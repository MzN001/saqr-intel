{
  "manifest_version": 3,
  "name": "Saqr — Abu Dhabi Scam Shield",
  "short_name": "Saqr",
  "version": "1.3.1",
  "description": "Checks websites, search results, Google Maps cards and Gmail / Outlook emails for scams before you click or type.",
  "permissions": [
    "webNavigation",
    "tabs",
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Saqr — Abu Dhabi Scam Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "lib/email_features.js",
        "lib/user_model.js",
        "lib/campaign_match.js",
        "content/common.js",
        "content/gmail.js"
      ],
      "css": [
        "content/mail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://outlook.cloud.microsoft/*"
      ],
      "js": [
        "lib/email_features.js",
        "lib/user_model.js",
        "lib/campaign_match.js",
        "content/common.js",
        "content/outlook.js"
      ],
      "css": [
        "content/mail.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://www.icloud.com/mail*",
        "https://mail.aol.com/*",
        "https://mail.zoho.com/*"
      ],
      "js": [
        "lib/config.js",
        "content/wip.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.ae/*",
        "https://www.google.com.sa/*",
        "https://www.google.com.qa/*",
        "https://www.google.com.kw/*",
        "https://www.google.com.om/*",
        "https://www.google.com.bh/*",
        "https://www.google.com.eg/*",
        "https://www.google.co.uk/*",
        "https://www.google.co.in/*",
        "https://www.google.com.pk/*",
        "https://www.google.com.ph/*",
        "https://www.google.de/*",
        "https://www.google.fr/*",
        "https://www.google.ca/*",
        "https://www.google.com.au/*",
        "https://www.bing.com/*"
      ],
      "js": [
        "lib/search_core.js",
        "content/search.js"
      ],
      "css": [
        "content/search.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "shield.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
